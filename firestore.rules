rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }
    match /trips/{tripId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /members/{memberId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        allow create, update: if request.auth != null
          && getAfter(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid;
      }
      match /days/{dayId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        allow create: if request.auth != null
          && request.resource.data.tripId == tripId
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        allow update: if request.auth != null
          && request.resource.data.tripId == tripId
          && request.resource.data.tripId == resource.data.tripId
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }
      match /places/{placeId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        match /votes/{userId} {
          allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
          allow create, update: if request.auth != null
            && request.auth.uid == userId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.choice in ['want', 'maybe', 'skip']
            && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
          allow delete: if request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        }
      }
    }
  }
}
